<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. 상단 헤더 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 이미지 아이콘 제거됨 -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 구분선 -->
    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <!-- 2. 입력 폼 (스크롤) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 아이디 -->
            <TextView
                android:text="아이디 *"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etId"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="아이디 입력 (6~20자)"
                    android:background="@drawable/input_box"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCheckId"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:text="중복확인"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#8665DC"
                    android:background="@drawable/gen_btn1"
                    android:backgroundTint="#DDDAFD"
                    app:strokeColor="#8665DC"
                    app:strokeWidth="1dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- 비밀번호 -->
            <TextView
                android:text="비밀번호 *"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/etPw"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="비밀번호 입력 (문자, 숫자, 특수문자 포함 8~20자)"
                android:inputType="textPassword"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- 비밀번호 확인 -->
            <TextView
                android:text="비밀번호 확인 *"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/etPwCheck"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="비밀번호 재입력"
                android:inputType="textPassword"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- 보호소 기관명 -->
            <TextView
                android:text="보호소 기관명 *"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/etShelterName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="보호소 기관명 입력"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- 전화번호 -->
            <TextView
                android:text="전화번호 *"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="전화번호 입력 (- 없이 숫자만)"
                android:inputType="phone"
                android:background="@drawable/input_box"
                android:paddingHorizontal="12dp"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- 지역 선택 -->
            <TextView
                android:text="지역 *"
                android:textSize="14sp"
                android:textColor="#333333"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- 스피너 배경은 input_box 재사용 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_box"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="40dp">

                <Spinner
                    android:id="@+id/spRegion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingStart="4dp"/> <!-- 화살표 아이콘은 기본 제공 사용 -->

                <!-- 스피너 오른쪽 화살표 아이콘 (선택 사항) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    app:tint="#999999"/>
            </RelativeLayout>

            <!-- 회원가입 버튼 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignUp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="회원가입"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#8665DC"
                android:background="@drawable/gen_btn1"
                android:backgroundTint="#DDDAFD"
                app:strokeColor="#8665DC"
                app:strokeWidth="1dp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>