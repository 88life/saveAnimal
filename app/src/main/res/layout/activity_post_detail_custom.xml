<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD">

    <!-- 1. 상단 배너 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFF3CD"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="#EFA65E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 수정됨: 타이틀 '공고글'로 변경 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="공고글"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#EFA65E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 스크롤 영역 (입력 폼) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- 강아지 사진 -->
            <ImageView
                android:id="@+id/imgDog"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:src="@drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:background="#EEEEEE"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* 사진을 터치하여 변경하세요"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"/>

            <!-- 정보 입력칸들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 이름 -->
                <TextView
                    android:text="이름"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etName"
                    android:hint="이름을 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 나이 -->
                <TextView
                    android:text="나이"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etAge"
                    android:hint="나이를 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 수정됨: 성별 (입력칸으로 변경) -->
                <TextView
                    android:text="성별"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etGender"
                    android:hint="성별을 입력하세요 (예: 수컷)"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 종 -->
                <TextView
                    android:text="종"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etBreed"
                    android:hint="품종을 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 성격 -->
                <TextView
                    android:text="성격"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etPersonality"
                    android:hint="성격을 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="textMultiLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 무서워하는 것 -->
                <TextView
                    android:text="무서워하는 것"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etFears"
                    android:hint="무서워하는 것을 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 질병 -->
                <TextView
                    android:text="질병"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etDiseases"
                    android:hint="질병 유무를 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- 보호소 정보 -->
                <TextView
                    android:text="보호소 정보"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/etShelter"
                    android:hint="보호소 정보를 입력하세요"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:background="@drawable/input_box"
                    android:padding="12dp"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3. 하단 버튼 (수평 정렬: 입양신청, 임보신청) -->
    <LinearLayout
        android:id="@+id/bottomButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdopt"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="입양신청하기"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/gen_btn1"
            android:backgroundTint="#EFA65E"
            android:layout_marginEnd="8dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFoster"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="임보신청하기"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#EFA65E"
            android:background="@drawable/input_box"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>