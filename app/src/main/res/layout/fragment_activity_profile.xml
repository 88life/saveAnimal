<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FDFDFD"
    tools:context=".ProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <View
            android:id="@+id/viewHeaderBg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFF3CD"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_menu_slideshow"
            android:layout_marginStart="16dp"
            app:tint="#EFA65E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/viewHeaderBg"
            app:layout_constraintBottom_toBottomOf="@id/viewHeaderBg" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="프로필"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#EFA65E"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/viewHeaderBg"
            app:layout_constraintBottom_toBottomOf="@id/viewHeaderBg" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvProfilePhoto"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="24dp"
            app:cardCornerRadius="35dp"
            app:cardBackgroundColor="#E6CDB2"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewHeaderBg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필\n사진"
                android:textColor="#5D4037"
                android:gravity="center"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnEditInfo"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="회원정보 수정"
            android:textSize="10sp"
            android:textColor="#757575"
            android:background="#E0E0E0"
            android:padding="0dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cvProfilePhoto"
            app:layout_constraintBottom_toBottomOf="@id/cvProfilePhoto" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="OO입양자님,\n어서오세요."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#EFA65E"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/cvProfilePhoto"
            app:layout_constraintEnd_toStartOf="@id/btnEditInfo"
            app:layout_constraintTop_toTopOf="@id/cvProfilePhoto"
            app:layout_constraintBottom_toBottomOf="@id/cvProfilePhoto" />


        <TextView
            android:id="@+id/tvSection1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내가 찜한 공고"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#EFA65E"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvProfilePhoto" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="자세히 보기"
            android:textSize="10sp"
            android:textColor="#795548"
            android:background="#E6CDB2"
            android:padding="0dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvSection1"
            app:layout_constraintTop_toTopOf="@id/tvSection1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:clipToPadding="false"
            android:layout_marginTop="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/tvSection1"
            tools:listitem="@layout/item_animal_card"/>


        <TextView
            android:id="@+id/tvSection2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내가 신청한 입양/임보"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#EFA65E"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvFavorites" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="자세히 보기"
            android:textSize="10dp"
            android:textColor="#795548"
            android:background="#E6CDB2"
            android:padding="0dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvSection2"
            app:layout_constraintTop_toTopOf="@id/tvSection2" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApplications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:clipToPadding="false"
            android:layout_marginTop="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/tvSection2"
            tools:listitem="@layout/item_animal_card"/>


        <LinearLayout
            android:id="@+id/llBottomButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/rvApplications"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <android.widget.Button
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="설정"
                android:textSize="12sp"
                android:background="@drawable/gen_btn1"
                android:textColor="#5D4037"
                android:layout_marginEnd="8dp"/>

            <android.widget.Button
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="로그아웃"
                android:textSize="12sp"
                android:background="@drawable/gen_btn1"
                android:textColor="#5D4037"
                android:layout_marginEnd="8dp"/>

            <android.widget.Button
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="회원탈퇴"
                android:textSize="12sp"
                android:background="@drawable/gen_btn1"
                android:textColor="#5D4037"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>