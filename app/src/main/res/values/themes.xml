<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SaveAnimal" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.SaveAnimal.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SaveAnimal.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.SaveAnimal.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

<!-- 기존 Theme.SaveAnimal 들은 그대로 두고, 이거만 추가 -->
<style name="SaveAnimal.MyOutlineButton" parent="@android:style/Widget.Button">
    <!-- 내가 만든 배경 사용 -->
    <item name="android:background">@drawable/save_btn1</item>
    <!-- 버튼 글자 색 -->
    <item name="android:textColor">@color/black</item>
</style>

</resources>
